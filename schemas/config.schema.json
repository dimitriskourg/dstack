{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dstack.local/schemas/config.schema.json",
  "title": "dstack personal configuration",
  "type": "object",
  "required": ["schema_version", "hosts"],
  "properties": {
    "schema_version": { "const": 2 },
    "hosts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "not": { "const": "auto" }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["profiles", "invalid_bindings", "transcripts_directory"],
        "properties": {
          "profiles": {
            "type": "object",
            "required": ["fast-explorer", "feature-worker", "bug-worker", "skeptical-reviewer"],
            "properties": {
              "fast-explorer": { "$ref": "#/$defs/modelBinding" },
              "feature-worker": { "$ref": "#/$defs/modelBinding" },
              "bug-worker": { "$ref": "#/$defs/modelBinding" },
              "skeptical-reviewer": { "$ref": "#/$defs/modelBinding" }
            },
            "additionalProperties": false
          },
          "invalid_bindings": { "type": "array", "items": { "$ref": "#/$defs/modelBinding" }, "uniqueItems": true },
          "transcripts_directory": { "type": ["string", "null"], "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "modelIdentifier": {
      "type": "string",
      "pattern": "^\\S+$",
      "not": { "enum": ["inherit-parent", "auto"] }
    },
    "modelBinding": {
      "type": "object",
      "required": ["model", "effort"],
      "properties": {
        "model": { "$ref": "#/$defs/modelIdentifier" },
        "effort": { "$ref": "#/$defs/modelIdentifier" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
