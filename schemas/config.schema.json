{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dstack.local/schemas/config.schema.json",
  "title": "dstack personal configuration",
  "type": "object",
  "required": ["schema_version", "hosts"],
  "properties": {
    "schema_version": { "const": 2 },
    "hosts": {
      "type": "object",
      "propertyNames": {
        "enum": ["codex", "claude", "cursor"]
      },
      "additionalProperties": {
        "type": "object",
        "required": ["profiles", "invalid_bindings", "worker_binding", "repositories"],
        "properties": {
          "profiles": {
            "type": "object",
            "required": ["fast-explorer", "feature-worker", "bug-worker", "skeptical-reviewer"],
            "properties": {
              "fast-explorer": { "$ref": "#/$defs/modelBinding" },
              "feature-worker": { "$ref": "#/$defs/modelBinding" },
              "bug-worker": { "$ref": "#/$defs/modelBinding" },
              "skeptical-reviewer": { "$ref": "#/$defs/modelBinding" }
            },
            "additionalProperties": false
          },
          "invalid_bindings": { "type": "array", "items": { "$ref": "#/$defs/modelBinding" }, "uniqueItems": true },
          "worker_binding": { "$ref": "#/$defs/workerBinding" },
          "repositories": {
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": { "$ref": "#/$defs/repositoryConfig" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "modelIdentifier": {
      "type": "string",
      "pattern": "^\\S+$",
      "not": { "enum": ["inherit-parent", "auto"] }
    },
    "repositoryConfig": {
      "type": "object",
      "required": ["repository_root", "transcripts_directory"],
      "properties": {
        "repository_root": { "type": "string", "minLength": 1 },
        "transcripts_directory": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workerBinding": {
      "type": "object",
      "required": ["mechanism", "definitions_directory"],
      "properties": {
        "mechanism": { "enum": ["spawn-arguments", "worker-definitions"] },
        "definitions_directory": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mechanism": { "const": "worker-definitions" } }, "required": ["mechanism"] },
          "then": { "properties": { "definitions_directory": { "type": "string" } } },
          "else": { "properties": { "definitions_directory": { "type": "null" } } }
        }
      ]
    },
    "modelBinding": {
      "type": "object",
      "required": ["model", "effort"],
      "properties": {
        "model": { "$ref": "#/$defs/modelIdentifier" },
        "effort": { "$ref": "#/$defs/modelIdentifier" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
