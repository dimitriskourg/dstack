{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dstack.local/schemas/config.schema.json",
  "title": "dstack personal configuration",
  "type": "object",
  "required": ["schema_version", "hosts"],
  "properties": {
    "schema_version": { "const": 3 },
    "hosts": {
      "type": "object",
      "propertyNames": {
        "enum": ["codex", "claude", "cursor"]
      },
      "properties": {
        "codex": { "$ref": "#/$defs/pairHost" },
        "claude": { "$ref": "#/$defs/pairHost" },
        "cursor": { "$ref": "#/$defs/cursorHost" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "modelIdentifier": {
      "type": "string",
      "pattern": "^[^\\[\\]\\s]+$",
      "not": { "enum": ["inherit-parent", "inherit", "auto"] }
    },
    "pairBinding": {
      "type": "object",
      "required": ["model", "effort"],
      "properties": {
        "model": { "$ref": "#/$defs/modelIdentifier" },
        "effort": { "$ref": "#/$defs/modelIdentifier" }
      },
      "additionalProperties": false
    },
    "cursorBinding": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "$ref": "#/$defs/modelIdentifier" }
      },
      "additionalProperties": false
    },
    "repositoryConfig": {
      "type": "object",
      "required": ["repository_root", "transcripts_directory"],
      "properties": {
        "repository_root": { "type": "string", "minLength": 1 },
        "transcripts_directory": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/repositoryConfig" }
    },
    "pairHost": {
      "type": "object",
      "required": ["profiles", "invalid_bindings", "repositories"],
      "properties": {
        "profiles": {
          "type": "object",
          "required": ["fast-explorer", "feature-worker", "bug-worker", "skeptical-reviewer"],
          "properties": {
            "fast-explorer": { "$ref": "#/$defs/pairBinding" },
            "feature-worker": { "$ref": "#/$defs/pairBinding" },
            "bug-worker": { "$ref": "#/$defs/pairBinding" },
            "skeptical-reviewer": { "$ref": "#/$defs/pairBinding" }
          },
          "additionalProperties": false
        },
        "invalid_bindings": { "type": "array", "items": { "$ref": "#/$defs/pairBinding" }, "uniqueItems": true },
        "repositories": { "$ref": "#/$defs/repositories" }
      },
      "additionalProperties": false
    },
    "cursorHost": {
      "type": "object",
      "required": ["profiles", "invalid_bindings", "repositories"],
      "properties": {
        "profiles": {
          "type": "object",
          "required": ["fast-explorer", "feature-worker", "bug-worker", "skeptical-reviewer"],
          "properties": {
            "fast-explorer": { "$ref": "#/$defs/cursorBinding" },
            "feature-worker": { "$ref": "#/$defs/cursorBinding" },
            "bug-worker": { "$ref": "#/$defs/cursorBinding" },
            "skeptical-reviewer": { "$ref": "#/$defs/cursorBinding" }
          },
          "additionalProperties": false
        },
        "invalid_bindings": { "type": "array", "items": { "$ref": "#/$defs/cursorBinding" }, "uniqueItems": true },
        "repositories": { "$ref": "#/$defs/repositories" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
