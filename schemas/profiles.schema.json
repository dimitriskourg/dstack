{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dstack.local/schemas/profiles.schema.json",
  "title": "dstack semantic model profiles",
  "type": "object",
  "required": ["schema_version", "roles"],
  "properties": {
    "schema_version": { "const": 1 },
    "roles": {
      "type": "object",
      "required": [
        "fast-explorer",
        "feature-worker",
        "bug-worker",
        "deep-judgment",
        "skeptical-reviewer",
        "independent-judge"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["model"],
        "properties": {
          "model": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
